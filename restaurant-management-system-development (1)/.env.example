# Copie para .env.local (desenvolvimento) ou .env.production.local (build).
# Os valores Firebase do cliente e a chave pública não são segredos; nunca inclua
# LICENSE_PEPPER, a chave privada RSA ou credenciais de service account aqui.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1
VITE_RECAPTCHA_V3_SITE_KEY=
VITE_LICENSE_PUBLIC_KEY_DER_BASE64=

# Apenas para desenvolvimento local. Remova/não configure em produção.
# Para obter um token de depuração, use true uma vez e registre o valor do console
# em Firebase Console > App Check > Tokens de depuração.
VITE_APPCHECK_DEBUG_TOKEN=
