rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura apenas de documento específico da chave digitada.
    // Proíbe listar toda a coleção (list: if false) para ninguém descobrir chaves de terceiros.
    // Proíbe qualquer escrita a partir do cliente (apenas o painel admin / Firebase Console altera).
    match /licencas/{chave} {
      allow get: if true;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
